# ============================================================================
# CONEXÃO — variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie este arquivo para ".env" (na raiz do projeto) e preencha os valores.
# O arquivo ".env" nunca deve ser commitado — ele já está no .gitignore.
#
# Em produção (Vercel), essas mesmas chaves são cadastradas no painel do
# projeto em "Settings → Environment Variables", nunca dentro do código.
# ============================================================================

# --- Banco de dados ---------------------------------------------------------
# String de conexão PostgreSQL. Em desenvolvimento você pode usar um Postgres
# local, ou já criar gratuitamente um banco em https://neon.tech (recomendado
# no README/DEPLOY.md). Formato:
# postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require
DATABASE_URL="postgresql://usuario:senha@localhost:5432/conexao"

# --- NextAuth ----------------------------------------------------------------
# URL pública onde o app está rodando. Em dev local, o padrão do Next.js.
NEXTAUTH_URL="http://localhost:3000"
# Segredo usado para assinar cookies/tokens de sessão. Gere um valor aleatório
# forte, por exemplo rodando no terminal: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-gerado-com-openssl"

# --- Login com Google ---------------------------------------------------------
# Criados em https://console.cloud.google.com/apis/credentials
# Passo a passo completo em docs/DEPLOY.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Login com Facebook -------------------------------------------------------
# Criados em https://developers.facebook.com/apps
# Passo a passo completo em docs/DEPLOY.md
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Login de demonstração (apenas desenvolvimento local) --------------------
# Quando "true", habilita um botão de "Entrar em modo demonstração" na tela de
# login, sem precisar configurar Google/Facebook. NUNCA habilite em produção.
ALLOW_DEMO_LOGIN="true"

# --- Integrações Google (Calendário, Contatos, Fotos) -------------------------
# Reutilizam o GOOGLE_CLIENT_ID/SECRET acima. Estas linhas documentam os
# escopos que serão solicitados quando essas integrações forem ativadas em
# uma próxima iteração (ver docs/ROADMAP.md). Nenhum código hoje depende
# delas ainda.
# GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/contacts.readonly https://www.googleapis.com/auth/photoslibrary.readonly"
